# Supabase project settings. Copy this file to backend/.env and replace values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Browser origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:3000

# Optional email configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional media and AI pipeline settings.
SUPABASE_VIDEO_BACKUP_BUCKET=lecture-video-backups
VIDEO_BACKUP_MAX_BYTES=2147483648
AI_REQUEST_TIMEOUT_MS=120000
GEMINI_CONTENT_FALLBACK_MODEL=gemini-2.5-flash
GENERATION_STALE_MINUTES=10
YOUTUBE_DOWNLOAD_ATTEMPTS=3
